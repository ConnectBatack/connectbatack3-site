# Copier ce fichier en .env.local pour travailler en local.
# Sur Vercel, ces variables se règlent dans Project > Settings > Environment Variables.
# Ne jamais mettre une vraie clé dans un fichier suivi par git.

# Adresse publique du site (sans / final). En local : http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clés Stripe en MODE TEST uniquement (elles commencent par sk_test_ et whsec_).
# Sans ces clés, le site fonctionne et le formulaire de don affiche « paiement pas encore activé ».
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
